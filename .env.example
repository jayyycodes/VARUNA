
# ── LLM Providers (Groq + Cerebras — both free tier for now) ──────────────
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Cerebras: https://cloud.cerebras.ai/platform/apikeys
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Which model each agent uses by default — see backend/gateway/ai_gateway.py
# for the full routing table and fallback logic.
PLANNER_MODEL=openai/gpt-oss-120b
RISK_EXPLAIN_MODEL=openai/gpt-oss-120b
RAG_MODEL=cerebras/gpt-oss-120b
FALLBACK_MODEL=cerebras/gpt-oss-120b

# ── Database (local Docker Postgres+PostGIS, from docker-compose.yml) ─────
POSTGRES_URL=postgresql://varuna:varuna_dev@localhost:5432/varuna

# ── Cache / Session (local Docker Redis) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── External data source APIs (no key needed for most — fill in if required) ─
# Open-Meteo: no key needed
# IMD: no key needed for public bulletins (confirm current access method)
# INCOIS: no key needed for public WebGIS/OSF endpoints
# MOSDAC: registration required for some products — https://mosdac.gov.in
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# ── Multilingual (Tier 2 — not needed for Day 0) ───────────────────────────
BHASHINI_API_KEY=

# ── Observability (set up once Day 0 core is working) ──────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=varuna-orca

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=development
